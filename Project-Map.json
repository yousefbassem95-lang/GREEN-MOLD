{
  "project": {
    "name": "Green Mold Cure",
    "version": "1.0.0",
    "description": "Advanced CLI Antivirus Scanner with Threat Intelligence",
    "created": "2026-02-17",
    "language": "Python",
    "min_python_version": "3.10"
  },
  "structure": {
    "source_root": "src",
    "modules": [
      {
        "name": "main",
        "path": "src/main.py",
        "purpose": "Application entry point with icon display and main loop",
        "dependencies": ["cli.menu", "cli.display", "config.settings"]
      },
      {
        "name": "cli",
        "path": "src/cli",
        "purpose": "Command-line interface components",
        "files": [
          {"name": "menu.py", "purpose": "Numbered menu system and input handling"},
          {"name": "display.py", "purpose": "Rich UI components with dark green theme"}
        ]
      },
      {
        "name": "scanner",
        "path": "src/scanner",
        "purpose": "Core scanning engine",
        "files": [
          {"name": "engine.py", "purpose": "Main scanning logic and file traversal"},
          {"name": "signatures.py", "purpose": "Signature-based detection"},
          {"name": "heuristics.py", "purpose": "Behavioral/heuristic analysis"}
        ]
      },
      {
        "name": "database",
        "path": "src/database",
        "purpose": "Threat database management and updates",
        "files": [
          {"name": "manager.py", "purpose": "SQLite database operations"},
          {"name": "updater.py", "purpose": "Database update orchestrator"},
          {"name": "sources", "path": "src/database/sources", "purpose": "Threat feed integrations"}
        ]
      },
      {
        "name": "quarantine",
        "path": "src/quarantine",
        "purpose": "Threat containment and management",
        "files": [
          {"name": "manager.py", "purpose": "Quarantine operations"},
          {"name": "vault.py", "purpose": "Secure storage for quarantined files"}
        ]
      },
      {
        "name": "utils",
        "path": "src/utils",
        "purpose": "Utility functions",
        "files": [
          {"name": "platform.py", "purpose": "OS detection and platform-specific handling"},
          {"name": "crypto.py", "purpose": "Encryption utilities"},
          {"name": "logger.py", "purpose": "Structured logging"}
        ]
      },
      {
        "name": "config",
        "path": "src/config",
        "purpose": "Configuration management",
        "files": [
          {"name": "settings.py", "purpose": "User preferences and settings"}
        ]
      }
    ],
    "tests": {
      "path": "tests",
      "files": [
        {"name": "test_scanner.py", "purpose": "Scanner module tests"},
        {"name": "test_database.py", "purpose": "Database module tests"},
        {"name": "test_quarantine.py", "purpose": "Quarantine module tests"},
        {"name": "test_cli.py", "purpose": "CLI module tests"}
      ]
    },
    "scripts": {
      "path": "scripts",
      "files": [
        {"name": "install.sh", "purpose": "Linux/macOS installer"},
        {"name": "install.bat", "purpose": "Windows installer"},
        {"name": "termux_setup.sh", "purpose": "Android Termux setup"}
      ]
    }
  },
  "threat_sources": {
    "surface_web": [
      {"name": "ClamAV", "type": "official_signatures", "api_required": false},
      {"name": "Abuse.ch", "type": "threat_feeds", "api_required": false, "feeds": ["MalwareBazaar", "URLhaus", "ThreatFox"]},
      {"name": "VirusTotal", "type": "api", "api_required": true, "env_var": "VIRUSTOTAL_API_KEY"},
      {"name": "Hybrid Analysis", "type": "api", "api_required": true, "env_var": "HYBRID_ANALYSIS_API_KEY"},
      {"name": "Any.run", "type": "api", "api_required": true, "env_var": "ANYRUN_API_KEY"},
      {"name": "AlienVault OTX", "type": "api", "api_required": true, "env_var": "ALIENVAULT_API_KEY"},
      {"name": "PhishTank", "type": "feed", "api_required": false}
    ],
    "deep_web": [
      {"name": "Tor .onion feeds", "type": "tor_integration", "requires": ["tor", "stem"], "api_required": false}
    ]
  },
  "data_storage": {
    "database": {
      "type": "SQLite",
      "location": "~/.green_mold_cure/signatures.db",
      "tables": ["signatures", "scan_history", "quarantine_log", "settings"]
    },
    "quarantine": {
      "location": "~/.green_mold_cure/quarantine/",
      "permissions": "000 (restricted)",
      "encryption": true
    },
    "logs": {
      "location": "~/.green_mold_cure/logs/",
      "format": "JSON",
      "rotation": "weekly"
    },
    "config": {
      "location": "~/.green_mold_cure/settings.json",
      "format": "JSON"
    }
  },
  "workflow": {
    "startup": [
      "Load icon from ICON.txt",
      "Initialize Rich console with dark green theme",
      "Load user settings",
      "Display main menu"
    ],
    "scan_flow": [
      "Select scan type",
      "Traverse target paths",
      "Hash files and check signatures",
      "Apply heuristic analysis",
      "Prompt user for each threat found",
      "Execute user choice (quarantine/purge/ignore)",
      "Log results"
    ],
    "update_flow": [
      "Connect to configured threat sources",
      "Fetch latest signatures",
      "Validate and merge into database",
      "Report update status"
    ]
  },
  "phases": {
    "phase_1": {
      "name": "Foundation",
      "status": "in_progress",
      "tasks": [
        "Project structure & documentation",
        "Rich CLI with dark green theme",
        "Numbered menu system",
        "Basic file scanning engine"
      ]
    },
    "phase_2": {
      "name": "Core Security",
      "status": "pending",
      "tasks": [
        "Signature-based detection",
        "Quarantine manager",
        "Threat prompt system"
      ]
    },
    "phase_3": {
      "name": "Database & Intelligence",
      "status": "pending",
      "tasks": [
        "SQLite database",
        "ClamAV integration",
        "Abuse.ch feeds",
        "API-based sources"
      ]
    },
    "phase_4": {
      "name": "Advanced Features",
      "status": "pending",
      "tasks": [
        "Tor integration",
        "Batch vulnerability scanning",
        "Report generation",
        "Heuristic analysis"
      ]
    },
    "phase_5": {
      "name": "Cross-Platform & Polish",
      "status": "pending",
      "tasks": [
        "Platform optimizations",
        "Installers",
        "Test suite",
        "Documentation finalization"
      ]
    }
  }
}
