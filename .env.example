# Green Mold Cure - Environment Variables Template
# Copy this file to .env and fill in your API keys
# NEVER commit .env files to version control!

# =============================================================================
# CLOUD SCANNING API KEYS (Optional)
# Get these keys from the respective services
# =============================================================================

# VirusTotal API Key
# Get from: https://www.virustotal.com/gui/my-apikey
# Free tier: 500 requests/day, 4 requests/minute
VIRUSTOTAL_API_KEY=

# Hybrid Analysis API Key
# Get from: https://www.hybrid-analysis.com/api/key
# Free tier available with registration
HYBRID_ANALYSIS_API_KEY=

# Any.run API Key
# Get from: https://any.run/api-documentation
# Free tier available
ANYRUN_API_KEY=

# AlienVault OTX API Key
# Get from: https://otx.alienvault.com/api
# Free with registration
ALIENVAULT_API_KEY=

# MetaDefender API Key (Optional)
# Get from: https://metadefender.opswat.com
METADEFENDER_API_KEY=

# Jotti's API Key (Optional)
# Get from: https://virusscan.jotti.org
JOTTI_API_KEY=

# =============================================================================
# TOR SETTINGS (Optional)
# For .onion threat feed integration
# =============================================================================

# Tor Proxy Host (default: 127.0.0.1)
TOR_PROXY_HOST=127.0.0.1

# Tor Proxy Port (default: 9050)
TOR_PROXY_PORT=9050

# =============================================================================
# APPLICATION SETTINGS (Optional)
# Most settings can be configured in the application UI
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Quarantine encryption key (auto-generated if not set)
# DO NOT set this manually unless you know what you're doing
# QUARANTINE_ENCRYPTION_KEY=

# =============================================================================
# NOTES:
# - Leave API keys blank if you don't have them (features will be disabled)
# - Cloud scanning works without API keys but with limited functionality
# - AI features use local Ollama - no API keys needed
# - Never share your .env file or commit it to version control
# =============================================================================
